<rml>
<head>
    <link type="text/rcss" href="rcss/settings.rcss" />
</head>

<body>
    <div id="settingsHeader" >
        <h1>Settings</h1>
    </div>
    <div data-model="settings_model" id="settingsMenu">

        <div class="settingOption">
            <h5>resolution</h5>
            <div class="spinnerBtn">
                <button id="resolution_back" class="button button1 arrow_btn" onclick=""></button>
                <div>
                    <p><span id="resolution_text">{{screenResolution}}</span></p>
                </div>
                <button id="resolution_front" class="button button1 arrow_btn" onclick=""></button>
            </div>
        </div>

        <div class="settingOption">
            <h5>Circle Polygons</h5>
            <div class="spinnerBtn">
                <button id="circle_back" class="button button1 arrow_btn" onclick=""></button>
                <div>
                    <p><span id="circle_resolution_text">{{circleResolution}}</span></p>
                </div>
                <button id="circle_front" class="button button1 arrow_btn" onclick=""></button>
            </div>
        </div>


        <button  id="windowMode" class="button button1" onclick="">fullscreen</button>

        <button id="Apply_btn" class="button button1">Apply</button>
        <button id="back_btn" class="button button1">Back</button>
    </div>
</body>
</rml>