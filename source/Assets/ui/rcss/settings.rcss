body {
    font-family: "Grixel Acme 9 Regular";
    background: white;
    color: blue;
    font-size: 42dp;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
}

#settingsMenu {
    width: 50%;
    height: 75%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    background-color: hsla(0, 1%, 51%, 0.1);
    margin-bottom: 1em;
    border-radius: 3em;
    border: 2px hsl(189, 75%, 52%);
}

#settingsMenu h1{
    color: green;
}

.button {
    background-color: hsl(194, 100%, 20%);
    padding: 16px 32px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 0.5em;
    margin: 6px 2px;
    transition: background-color color 0.2s linear-out;
    width: 40%;
}

.button1 {
    border: 2px hsl(189, 75%, 52%);
    color: hsl(189, 75%, 52%);
}

.button1:hover {
    background-color: orange;
    color: white;
}

.divider {
    display: block;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 2em;
    width: 75%;
    height: 4px;
    background-color: hsl(189, 75%, 52%);
}

label {
  font-size: 1rem;
  padding-right: 10px;
}

select {
  font-size: 0.9rem;
  padding: 2px 5px;
}

#settingsHeader {
    width: 100%;
    height: 25%;
    color: blue;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

#settingsHeader h1 {

    width: 100%;
    margin-top: 1em;
    margin-bottom: 1em;
    font-size: 66px;
    text-align: center;
    color: hsl(189, 75%, 52%);

}

.settingOption{
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.settingOption h5{
    font-size: 40px;
    color: black;
    margin-bottom: 0.5em;
}
.spinnerBtn {
    display: flex;
    justify-content: center;
    align-items: center;
}

.spinnerBtn div {

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    height: 72px;
    width: 10em;
    margin: 0;

    color: black;
    background-color: hsl(189, 75%, 52%);
    border: 2px aqua;
    font-size: 30px;

}

.arrow_btn
{
    width: 72px;
    height: 72px;
    box-sizing: border-box;
    padding: 0;
    margin: 0 10px;
}

#resolution-back {
    decorator: image("../../imgs/arrow.tga" flip-horizontal contain center center);
}

#resolution-front {
    decorator: image("../../imgs/arrow.tga" contain center center);
}

#circle-back {
    decorator: image("../../imgs/arrow.tga" flip-horizontal contain center center);
}

#circle-front {
    decorator: image("../../imgs/arrow.tga" contain center center);
}